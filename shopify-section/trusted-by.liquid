{% comment %}
  Trusted By Brand Strip Section - Custom Shopify Section
  Create this file in your Shopify theme under the "sections" folder as "trusted-by.liquid".
{% endcomment %}

<div class="trusted-by-section" id="TrustedBy-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="trusted-by-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="marquee-container">
    {% comment %} Left and Right Fade Overlays {% endcomment %}
    <div class="marquee-fade-left"></div>
    <div class="marquee-fade-right"></div>

    {% comment %} Row 1 — scrolls continuously from left to right (reverse) {% endcomment %}
    <div class="marquee-row marquee-row--reverse">
      <div class="marquee-track">
        {% for i in (1..3) %}
          {% for block in section.blocks %}
            {% if block.settings.row == '1' %}
              <div class="brand-item" {{ block.shopify_attributes }}>
                {% if block.type == 'brand_image' and block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 350 }}" 
                       alt="{{ block.settings.image.alt | default: 'Brand Logo' }}" 
                       class="brand-image" 
                       loading="lazy">
                {% elsif block.type == 'brand_text' and block.settings.text != blank %}
                  <span class="brand-text brand-text--{{ block.settings.text_style }}">
                    {{ block.settings.text }}
                  </span>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>

    {% comment %} Row 2 — scrolls continuously from right to left {% endcomment %}
    <div class="marquee-row">
      <div class="marquee-track">
        {% for i in (1..3) %}
          {% for block in section.blocks %}
            {% if block.settings.row == '2' %}
              <div class="brand-item" {{ block.shopify_attributes }}>
                {% if block.type == 'brand_image' and block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 350 }}" 
                       alt="{{ block.settings.image.alt | default: 'Brand Logo' }}" 
                       class="brand-image" 
                       loading="lazy">
                {% elsif block.type == 'brand_text' and block.settings.text != blank %}
                  <span class="brand-text brand-text--{{ block.settings.text_style }}">
                    {{ block.settings.text }}
                  </span>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
  #TrustedBy-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }
  #TrustedBy-{{ section.id }} .trusted-by-heading {
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: {{ section.settings.heading_color }} !important;
    margin: 0 0 45px 0;
    line-height: 1.2;
  }
  #TrustedBy-{{ section.id }} .marquee-container {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.row_gap_desktop }}px;
    position: relative;
    width: 100%;
  }
  #TrustedBy-{{ section.id }} .marquee-row {
    display: flex;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
    width: 100%;
  }
  #TrustedBy-{{ section.id }} .marquee-track {
    display: flex;
    align-items: center;
    gap: {{ section.settings.logo_gap_desktop }}px;
    width: max-content;
    animation: marquee-left-{{ section.id }} {{ section.settings.animation_speed }}s linear infinite;
  }
  #TrustedBy-{{ section.id }} .marquee-row--reverse .marquee-track {
    animation: marquee-right-{{ section.id }} {{ section.settings.animation_speed }}s linear infinite;
  }

  /* Pause marquee on hover */
  #TrustedBy-{{ section.id }} .marquee-row:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-left-{{ section.id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.3333%); }
  }
  @keyframes marquee-right-{{ section.id }} {
    0% { transform: translateX(-33.3333%); }
    100% { transform: translateX(0); }
  }

  /* Fade gradient effects */
  #TrustedBy-{{ section.id }} .marquee-fade-left,
  #TrustedBy-{{ section.id }} .marquee-fade-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 180px;
    z-index: 2;
    pointer-events: none;
  }
  #TrustedBy-{{ section.id }} .marquee-fade-left {
    left: 0;
    background: linear-gradient(to right, {{ section.settings.bg_color }} 15%, transparent);
  }
  #TrustedBy-{{ section.id }} .marquee-fade-right {
    right: 0;
    background: linear-gradient(to left, {{ section.settings.bg_color }} 15%, transparent);
  }

  /* Brand Item & Hover physics */
  #TrustedBy-{{ section.id }} .brand-item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    opacity: 0.65;
    filter: grayscale(100%);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }
  #TrustedBy-{{ section.id }} .brand-item:hover {
    opacity: 1 !important;
    filter: grayscale(0%) !important;
    transform: scale(1.1);
  }
  #TrustedBy-{{ section.id }} .brand-image {
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }

  /* Mockup specific premium typography */
  #TrustedBy-{{ section.id }} .brand-text {
    font-size: 24px;
    line-height: 1;
    user-select: none;
    color: #2c2c2c !important;
  }
  #TrustedBy-{{ section.id }} .brand-text--daily-objects {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 600;
    color: #333333 !important;
  }
  #TrustedBy-{{ section.id }} .brand-text--murzban {
    font-family: "Arial Black", -apple-system, sans-serif;
    font-weight: 900;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 25px;
    color: #111111 !important;
  }
  #TrustedBy-{{ section.id }} .brand-text--sephani {
    font-family: "Playfair Display", Georgia, Times, serif;
    font-style: italic;
    font-weight: 300;
    font-size: 26px;
    letter-spacing: 0.05em;
    color: #222222 !important;
  }
  #TrustedBy-{{ section.id }} .brand-text--minitpe {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 800;
    color: #2c2c2c !important;
  }
  #TrustedBy-{{ section.id }} .brand-text--glissbery {
    font-family: "Arial Black", -apple-system, sans-serif;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #111111 !important;
  }
  #TrustedBy-{{ section.id }} .brand-text--twinleave {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #333333 !important;
    font-size: 20px;
  }
  #TrustedBy-{{ section.id }} .brand-text--plutoze {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 800;
    font-style: italic;
    color: #222222 !important;
  }
  #TrustedBy-{{ section.id }} .brand-text--laxery {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: #222222 !important;
  }
  #TrustedBy-{{ section.id }} .brand-text--sparsco {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
    color: #111111 !important;
  }
  #TrustedBy-{{ section.id }} .brand-text--street9 {
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #333333 !important;
    font-size: 20px;
  }

  /* Responsive styling and parameters */
  @media (max-width: 767px) {
    #TrustedBy-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    #TrustedBy-{{ section.id }} .trusted-by-heading {
      margin-bottom: 30px;
      font-size: 9.5px;
      letter-spacing: 0.2em;
    }
    #TrustedBy-{{ section.id }} .marquee-container {
      gap: {{ section.settings.row_gap_mobile }}px;
    }
    #TrustedBy-{{ section.id }} .marquee-track {
      gap: {{ section.settings.logo_gap_mobile }}px;
    }
    #TrustedBy-{{ section.id }} .marquee-fade-left,
    #TrustedBy-{{ section.id }} .marquee-fade-right {
      display: none;
    }
    #TrustedBy-{{ section.id }} .brand-item {
      height: 36px;
    }
    #TrustedBy-{{ section.id }} .brand-text {
      font-size: 18px;
    }
    #TrustedBy-{{ section.id }} .brand-text--murzban {
      font-size: 19px;
    }
    #TrustedBy-{{ section.id }} .brand-text--sephani {
      font-size: 19px;
    }
    #TrustedBy-{{ section.id }} .brand-text--twinleave,
    #TrustedBy-{{ section.id }} .brand-text--street9 {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Trusted By Brand Strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "POWERING GROWTH FOR COMPANIES LIKE"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Animation Duration (Scroll speed)",
      "default": 35
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "logo_gap_desktop",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Gap between logos (Desktop)",
      "default": 120
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between rows (Desktop)",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "logo_gap_mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between logos (Mobile)",
      "default": 60
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Gap between rows (Mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "brand_text",
      "name": "Brand Text Name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Brand Name",
          "default": "Daily Objects"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "Brand Text Font Style",
          "options": [
            { "value": "daily-objects", "label": "Daily Objects (Sans bold)" },
            { "value": "murzban", "label": "MURZBAN (Extra Heavy Caps)" },
            { "value": "sephani", "label": "Sephani (Serif Italic)" },
            { "value": "minitpe", "label": "minitpe. (Heavy Lowercase with Dot)" },
            { "value": "glissbery", "label": "GLISSBERY (Heavy Caps)" },
            { "value": "twinleave", "label": "TWINLEAVE (Caps spaced with Caret)" },
            { "value": "plutoze", "label": "Plutoze (Bold Sans Italic)" },
            { "value": "laxery", "label": "LAXERY (Light Caps Spaced)" },
            { "value": "sparsco", "label": "SPARSCO (Bold Italic Caps)" },
            { "value": "street9", "label": "STREET9 (Wide Caps)" }
          ],
          "default": "daily-objects"
        },
        {
          "type": "select",
          "id": "row",
          "label": "Marquee Row",
          "options": [
            { "value": "1", "label": "Row 1 (Left to Right)" },
            { "value": "2", "label": "Row 2 (Right to Left)" }
          ],
          "default": "1"
        }
      ]
    },
    {
      "type": "brand_image",
      "name": "Brand Logo Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "select",
          "id": "row",
          "label": "Marquee Row",
          "options": [
            { "value": "1", "label": "Row 1 (Left to Right)" },
            { "value": "2", "label": "Row 2 (Right to Left)" }
          ],
          "default": "1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trusted By Brand Strip",
      "category": "Promotional",
      "blocks": [
        {
          "type": "brand_text",
          "settings": {
            "text": "Daily Objects",
            "text_style": "daily-objects",
            "row": "1"
          }
        },
        {
          "type": "brand_text",
          "settings": {
            "text": "MURZBAN",
            "text_style": "murzban",
            "row": "1"
          }
        },
        {
          "type": "brand_text",
          "settings": {
            "text": "Sephani",
            "text_style": "sephani",
            "row": "1"
          }
        },
        {
          "type": "brand_text",
          "settings": {
            "text": "minitpe.",
            "text_style": "minitpe",
            "row": "1"
          }
        },
        {
          "type": "brand_text",
          "settings": {
            "text": "GLISSBERY",
            "text_style": "glissbery",
            "row": "1"
          }
        },
        {
          "type": "brand_text",
          "settings": {
            "text": "^ TWINLEAVE",
            "text_style": "twinleave",
            "row": "2"
          }
        },
        {
          "type": "brand_text",
          "settings": {
            "text": "Plutoze",
            "text_style": "plutoze",
            "row": "2"
          }
        },
        {
          "type": "brand_text",
          "settings": {
            "text": "LAXERY",
            "text_style": "laxery",
            "row": "2"
          }
        },
        {
          "type": "brand_text",
          "settings": {
            "text": "SPARSCO",
            "text_style": "sparsco",
            "row": "2"
          }
        },
        {
          "type": "brand_text",
          "settings": {
            "text": "STREET9",
            "text_style": "street9",
            "row": "2"
          }
        }
      ]
    }
  ]
}
{% endschema %}
